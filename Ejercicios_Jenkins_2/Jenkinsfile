pipeline {
  agent {
    docker {
      image 'gradle:6.6.1-jre14-openj9'
    }
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'master',
            url: 'https://github.com/Lemoncode/bootcamp-devops-lemoncode.git'
      }
    }

    stage('Compile') {
      steps {
        dir('03-cd/exercises/jenkins-resources/calculator') {
          sh './gradlew compileJava'
        }
      }
    }

    stage('Unit Tests') {
      steps {
        dir('03-cd/exercises/jenkins-resources/calculator') {
          sh './gradlew test'
        }
      }
    }
  }
}